# Your application in Qeet ID (a confidential web application).
QEET_ID_CLIENT_ID=
QEET_ID_CLIENT_SECRET=
# Encrypts the session cookie: openssl rand -base64 32
QEET_ID_SECRET=
# This app's origin. Register {QEET_ID_APP_URL}/auth/callback as a redirect URI.
QEET_ID_APP_URL=http://localhost:3000
# Optional: the organisation's name and the person's roles and permissions in the session.
# QEET_ID_API_KEY=
