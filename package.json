{
  "name": "@qeet-id/nextjs",
  "version": "0.1.0",
  "description": "Sign-in with Qeet ID for Next.js: the session routes, an encrypted cookie session, route protection and server helpers. Tokens stay on your server.",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-nextjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-nextjs.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-nextjs/issues"
  },
  "keywords": [
    "qeet",
    "qeet-id",
    "nextjs",
    "next",
    "app-router",
    "authentication",
    "oidc",
    "oauth",
    "pkce",
    "session",
    "backend-for-frontend",
    "sdk"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "default": "./dist/client/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/app-router",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --diagnostic-level=error .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify"
  },
  "dependencies": {
    "@qeet-id/node": "^0.1.0 || ^1.0.0",
    "@qeet-id/react": "^0.1.0 || ^1.0.0",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "next": "^16.4.5",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
